# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/keerthana_tours

# Auth (JWT_SECRET must be at least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_HOURS=24

# CORS: the origin(s) of your React app (comma-separated for more than one).
# Vite dev server is usually http://localhost:5173, Create React App http://localhost:3000
CLIENT_ORIGIN=http://localhost:5173

# Cookie settings
# lax  -> frontend and backend on the same site (e.g. localhost, or app.example.com + api.example.com)
# none -> frontend and backend on different sites (requires HTTPS; Secure is forced on)
COOKIE_SAME_SITE=lax
# Optional. Defaults to true when NODE_ENV=production, otherwise false.
# COOKIE_SECURE=true

# Used ONLY by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
